# ── Supabase (Required) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Email (up to 4 IMAP inboxes) ─────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
INBOX_1_HOST=imap.gmail.com
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_NAME=
# INBOX_1_PORT=993            # optional, defaults to 993
INBOX_2_HOST=
INBOX_2_USER=
INBOX_2_PASS=
INBOX_3_HOST=
INBOX_3_USER=
INBOX_3_PASS=
INBOX_4_HOST=
INBOX_4_USER=
INBOX_4_PASS=

# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) with scopes: channels:read, channels:history, users:read
SLACK_BOT_TOKEN=

# ── Payment processors ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=            # full client implemented (balance + charges)
PAYPAL_CLIENT_ID=             # registered; client lands when keys do
PAYPAL_CLIENT_SECRET=
SQUARE_ACCESS_TOKEN=
WHOP_API_KEY=

# ── Notion ───────────────────────────────────────────────────────────────
# Internal integration secret; share target pages with the integration
NOTION_API_KEY=

# ── Launchpad Cohort ───────────────────────────────────────────────────
WEBINARJAM_API_KEY=          # account-wide key; pulls webinar registrants/attendees
TRAKYO_API_KEY=              # revenue attribution; status-only until Trakyo ships an API
GHL_API_KEY=                 # GoHighLevel Private Integration token (Settings → Private Integrations, read scopes)
GHL_LOCATION_ID=             # the LC sub-account location id (visible in the GHL URL: /v2/location/<id>/…)

# ── G-Brain ──────────────────────────────────────────────────────────────
# Defaults work: gbrain CLI on PATH, store at knowledge/brain-store
BRAIN_PROVIDER=gbrain       # set to "stub" to disable
GBRAIN_BIN=                 # override CLI path
GBRAIN_STORE=               # override brain-store path (default: ~/knowledge/brain-store)
GBRAIN_CONFIG=              # override config path (default: ~/.config/knowledge/config.json)

# ── Local LLM (for agents) ───────────────────────────────────────────────
# OPENAI_API_KEY=             # if using OpenAI models via the LLM connector
# ANTHROPIC_API_KEY=          # if using Anthropic models via the LLM connector
# LOCAL_LLM_BASE_URL=         # e.g., http://localhost:11434 for Ollama
# LOCAL_LLM_MODEL=            # e.g., llama3:8b

# ── Miscellaneous ────────────────────────────────────────────────────────
# FOUNDER_OS_ACCESS_TOKEN=    # if set, enables the access gate for public deployments
# FOUNDER_OS_DB=:memory:      # set to :memory: for an in-memory SQLite database (useful for tests)
# BANK_DB=                    # override bank store path (default: data/bank.db)
# LEDGER_DB=                  # override ledger store path (default: data/ledger.db)